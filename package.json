{
  "name": "polislab",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "PolisLab interactive research laboratory — Overview, Claims, Casebook, Mechanisms, Comparison, Evidence Gaps",
  "scripts": {
    "ingest": "tsx scripts/ingest-research.ts",
    "validate": "tsx scripts/validate-research.ts",
    "validate:release": "tsx scripts/validate-release.ts",
    "predev": "npm run ingest",
    "dev": "vite",
    "prebuild": "npm run ingest && npm run validate",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --workers=1",
    "test:all": "npm run validate && npm run validate:release && npm run test && npm run test:e2e",
    "verify:research": "python3 scripts/independent_verify_atlas.py && python3 scripts/independent_verify_casebook.py && python3 scripts/independent_verify_mechanisms.py && python3 scripts/independent_verify_gaps.py",
    "verify:mechanisms": "python3 scripts/independent_verify_mechanisms.py",
    "verify:gaps": "python3 scripts/independent_verify_gaps.py",
    "check:artifacts": "tsx scripts/check-artifact-safety.ts"
  },
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "dependencies": {
    "mdast-util-to-string": "^4.0.0",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
