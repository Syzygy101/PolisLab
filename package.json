{
  "name": "polislab",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "PolisLab interactive research laboratory — Claims Explorer foundation",
  "scripts": {
    "ingest": "tsx scripts/ingest-research.ts",
    "validate": "tsx scripts/validate-research.ts",
    "predev": "npm run ingest",
    "dev": "vite",
    "prebuild": "npm run ingest && npm run validate",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run validate && npm run test && npm run test:e2e"
  },
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "dependencies": {
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
